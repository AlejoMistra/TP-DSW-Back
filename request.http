###############################################################################

### ❌ PUT - Actualizar con email duplicado
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "email": "maria.gonzalez@example.com"
}

### ❌ PUT - Actualizar nombre a muy corto
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "A"
}

### ❌ PUT - Actualizar email inválido
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "email": "email-invalido"
}

### ❌ PUT - Actualizar teléfono inválido
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "phone": "123"
}

### ❌ PUT - Status inválido
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "status": "PENDIENTE"
}

### ❌ PUT - ID que no existe
PUT {{baseUrl}}/members/9999
Content-Type: application/json

{
  "name": "NoExiste"
}

### ❌ PUT - ID inválido
PUT {{baseUrl}}/members/abc
Content-Type: application/json

{
  "name": "Test"
}

### ❌ PUT - JSON inválido
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "Test"
  "surname": "Test"
}


###############################################################################
# 7️⃣ DELETE - ELIMINAR MIEMBROS (Soft Delete)
###############################################################################

### ✅ DELETE - Eliminar miembro válido
DELETE {{baseUrl}}/members/1

### ✅ DELETE - Eliminar otro miembro
DELETE {{baseUrl}}/members/2

### ✅ DELETE - Verificar que está eliminado (soft delete, no desaparece)
GET {{baseUrl}}/members/1

### ❌ DELETE - Intentar eliminar un ID que no existe
DELETE {{baseUrl}}/members/9999

### ❌ DELETE - Intentar eliminar con ID inválido
DELETE {{baseUrl}}/members/abc

### ❌ DELETE - ID negativo
DELETE {{baseUrl}}/members/-1


###############################################################################
# 8️⃣ PATCH - RESTAURAR MIEMBROS ELIMINADOS
###############################################################################

### ✅ PATCH - Restaurar miembro eliminado
PATCH {{baseUrl}}/members/1/restore

### ✅ PATCH - Verificar que está restaurado
GET {{baseUrl}}/members/1

### ✅ PATCH - Restaurar otro miembro
PATCH {{baseUrl}}/members/2/restore

### ❌ PATCH - Restaurar un ID que no existe
PATCH {{baseUrl}}/members/9999/restore

### ❌ PATCH - Restaurar con ID inválido
PATCH {{baseUrl}}/members/abc/restore


###############################################################################
# 9️⃣ CASOS DE ESTRÉS (Romper el sistema)
###############################################################################

### ❌ POST - Crear 100 miembros (spam)
POST {{baseUrl}}/members
{{@contentType}}

{
  "name": "Test1",
  "surname": "Spam",
  "email": "spam1@example.com"
}

### ❌ PUT - Actualizar con campos que no existen
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "Test",
  "fieldoInexistente": "valor"
}

### ❌ POST - Array en lugar de objeto
POST {{baseUrl}}/members
Content-Type: application/json

[
  {
    "name": "Test",
    "surname": "Test",
    "email": "array@example.com"
  }
]

### ❌ POST - Null como body
POST {{baseUrl}}/members
Content-Type: application/json

null

### ❌ POST - String en lugar de JSON
POST {{baseUrl}}/members
Content-Type: application/json

"esto no es un objeto"

### ❌ POST - Número en lugar de JSON
POST {{baseUrl}}/members
Content-Type: application/json

123

### ❌ GET - ID muy grande
GET {{baseUrl}}/members/99999999999999999999

### ❌ PUT - Cambiar todos los campos a valores mínimos
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "ab",
  "surname": "cd",
  "email": "a@b.c"
}

### ❌ POST - Todos los campos vacíos
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "",
  "surname": "",
  "email": "",
  "phone": ""
}


###############################################################################
# 🔟 FLUJO COMPLETO (Happy Path)
###############################################################################

### PASO 1: Crear un miembro nuevo
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "FlowTest",
  "surname": "Complete",
  "email": "flowtest@example.com",
  "phone": "1111111111",
  "status": "ACTIVE"
}

### PASO 2: Obtener todos (verificar que está en la lista)
GET {{baseUrl}}/members

### PASO 3: Obtener el miembro por ID (cambiar ID según la respuesta anterior)
GET {{baseUrl}}/members/1

### PASO 4: Actualizar el miembro
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "FlowTestUpdated",
  "phone": "2222222222"
}

### PASO 5: Verificar la actualización
GET {{baseUrl}}/members/1

### PASO 6: Cambiar a INACTIVE
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "status": "INACTIVE"
}

### PASO 7: Cambiar a ACTIVE nuevamente
PUT {{baseUrl}}/members/1
Content-Type: application/json  

{
  "status": "ACTIVE"
}

### PASO 8: Eliminar (soft delete)
DELETE {{baseUrl}}/members/1

### PASO 9: Intentar obtener (debería estar marcado como eliminado)
GET {{baseUrl}}/members/1

### PASO 10: Restaurar
PATCH {{baseUrl}}/members/1/restore

### PASO 11: Verificar que está restaurado
GET {{baseUrl}}/members/1
