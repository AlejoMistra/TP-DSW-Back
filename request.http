###############################################################################
# 4️⃣ GET - OBTENER MIEMBRO POR ID (Casos válidos e inválidos)
###############################################################################

### ✅ GET - Obtener miembro por ID válido (cambiar ID según necesites)
GET {{baseUrl}}/members/1

### ✅ GET - Obtener miembro por ID 2
GET {{baseUrl}}/members/2

### ✅ GET - Obtener miembro por ID 3
GET {{baseUrl}}/members/3

### ❌ GET - ID que no existe
GET {{baseUrl}}/members/9999

### ❌ GET - ID con formato inválido (letra)
GET {{baseUrl}}/members/abc

### ❌ GET - ID con formato inválido (símbolo)
GET {{baseUrl}}/members/@123

### ❌ GET - ID negativo
GET {{baseUrl}}/members/-1

### ❌ GET - ID decimal
GET {{baseUrl}}/members/1.5

### ❌ GET - Sin ID
GET {{baseUrl}}/members/


###############################################################################
# 5️⃣ PUT - ACTUALIZAR MIEMBROS (Casos válidos)
###############################################################################

### ✅ PUT - Actualizar solo nombre
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "JuanActualizado"
}

### ✅ PUT - Actualizar solo email
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "email": "juanuevo@example.com"
}

### ✅ PUT - Actualizar solo teléfono
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "phone": "9999999999"
}

### ✅ PUT - Actualizar solo status
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "status": "INACTIVE"
}

### ✅ PUT - Actualizar múltiples campos
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "name": "JuanCompleto",
  "surname": "PérezActualizado",
  "email": "juancompleto@example.com",
  "phone": "5555555555",
  "status": "ACTIVE"
}

### ✅ PUT - Cambiar status a INACTIVE
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "status": "INACTIVE"
}

### ✅ PUT - Volver a cambiar status a ACTIVE
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "status": "ACTIVE"
}

### ✅ PUT - Limpiar teléfono (null)
PUT {{baseUrl}}/members/1
Content-Type: application/json

{
  "phone": null
}


