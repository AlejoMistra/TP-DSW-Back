###############################################################################
# MEMBER CRUD - Testing Completo
# Para usar: Instala la extensión "REST Client" en VS Code
# Luego clickea "Send Request" encima de cada bloque
###############################################################################

### ========== VARIABLES ==========
@baseUrl = http://localhost:3000/api
@contentType = Content-Type: application/json

### ========== VARIABLES DE RESPUESTA (se actualizan automáticamente) ==========
@memberId = 999

###############################################################################
# 1️⃣ GET - OBTENER TODOS LOS MIEMBROS (Sin filtros)
###############################################################################

### ✅ GET - Traer todos los miembros
GET {{baseUrl}}/members

### ✅ GET - Traer todos (verificar estructura)
GET {{baseUrl}}/members
Accept: application/json


###############################################################################
# 2️⃣ POST - CREAR MIEMBROS (Casos válidos)
###############################################################################

### ✅ POST - Crear miembro COMPLETO (todos los campos)
### POST - Crear miembro
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Juan",
  "surname": "Pérez",
  "email": "juan12345@example.com",
  "phone": "1234567890"
}

### ✅ POST - Crear miembro MÍNIMO (solo requeridos)
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "María",
  "surname": "González",
  "email": "maria.gonzalez@example.com"
}

### ✅ POST - Crear miembro sin teléfono (phone es opcional)
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Carlos",
  "surname": "López",
  "email": "carlos.lopez@example.com",
  "phone": null
}

### ✅ POST - Crear miembro con estado INACTIVE
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Alejo",
  "surname": "Borda",
  "email": "alejo.borda@example.com",
  "phone": "9876543210",
  "status": "INACTIVE"
}

### ✅ POST - Crear miembro con fecha personalizada
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Roberto",
  "surname": "Sánchez",
  "email": "roberto.sanchez@example.com",
  "phone": "5555555555",
  "joinDate": "2023-06-20T08:00:00Z"
}


###############################################################################
# 3️⃣ POST - CREAR MIEMBROS (Casos INVÁLIDOS - Deben fallar)
###############################################################################

### ❌ POST - Nombre muy corto (menos de 2 caracteres)
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "A",
  "surname": "González",
  "email": "test1@example.com"
}

### ❌ POST - Nombre vacío
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "",
  "surname": "González",
  "email": "test2@example.com"
}

### ❌ POST - Apellido muy corto
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Juan",
  "surname": "G",
  "email": "test3@example.com"
}

### ❌ POST - Email inválido
POST {{baseUrl}}/members
Content-Type: application/json      

{
  "name": "Juan",
  "surname": "García",
  "email": "email-invalido"
}

### ❌ POST - Email sin dominio
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Juan",
  "surname": "García",
  "email": "juan@"
}

### ❌ POST - Email duplicado (crear 2 veces el mismo)
POST {{baseUrl}}/members
Content-Type: application/json

{
  "name": "Duplicado",
  "surname": "Test",
  "email": "duplicado@example.com"
}

