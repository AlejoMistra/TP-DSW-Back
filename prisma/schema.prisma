// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mysql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/zod"
  config   = "./zod-generator.config.json"
}

model Member {
  id         Int         @id @default(autoincrement())
  /// @zod.min(2, "Nombre debe tener al menos 2 caracteres").max(100, "Nombre máximo 100 caracteres")
  name       String
  /// @zod.min(2, "Apellido debe tener al menos 2 caracteres").max(100, "Apellido máximo 100 caracteres")
  surname    String
  /// @zod.email("Email inválido")
  email      String      @unique
  /// @zod.custom.use(z.string().regex(/^\d{7,15}$/, "Teléfono debe tener entre 7 y 15 dígitos"))
  phone      String?
  docType    docType     @default(DNI)
  /// @zod.length(8, "Formato invalido de documento")
  docNumber  String      @default("")
  /// @zod.custom.use(z.coerce.date())
  birthDate  DateTime
  membership Membership?
  status     Status      @default(ACTIVE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  classBookings ClassBooking[]

  @@map("members")
}

model Instructor {
  id       Int      @id @default(autoincrement())
  name     String
  surname  String
  email    String   @unique
  phone    String?
  joinDate DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  routines Routine[]
  classSessions ClassSession[]

  @@map("instructors")
}

model Membership {
  id        Int              @id @default(autoincrement())
  /// @zod.custom.use(z.coerce.date())
  startDate DateTime         @default(now())
  /// @zod.custom.use(z.coerce.date())
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // UN SOCIO TIENE SOLO UNA MEMBRESÍA (1:1)
  member   Member @relation(fields: [memberId], references: [id])
  /// @zod.positive("El ID del socio debe ser mayor a 0")
  memberId Int    @unique

  // MUCHAS MEMBRESÍAS COMPARTEN EL MISMO PLAN (1:N)
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])
  /// @zod.positive("El ID del plan debe ser mayor a 0")
  membershipPlanId Int

  payments Payment[]

  @@map("memberships")
}

model Payment {
  id          Int           @id @default(autoincrement())
  /// @zod.custom.use(z.coerce.number().positive("El monto del pago debe ser mayor a 0"))
  amount      Decimal
  method      PaymentMethod
  /// @zod.custom.use(z.coerce.date())
  paymentDate DateTime      @default(now())
  /// @zod.custom.use(z.coerce.date())
  periodStart DateTime
  /// @zod.custom.use(z.coerce.date())
  periodEnd   DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  membership   Membership @relation(fields: [membershipId], references: [id])
  /// @zod.positive("El ID de membresía debe ser mayor a 0")
  membershipId Int

  @@index([membershipId])
  @@map("payments")
}

model MembershipPlan {
  id           Int     @id @default(autoincrement())
  /// @zod.min(1, "El nombre del plan no puede estar vacío").max(100, "El nombre del plan no puede superar los 100 caracteres")
  name         String
  /// @zod.max(500, "La descripción del plan no puede superar los 500 caracteres")
  description  String?
  /// @zod.positive("El precio del plan debe ser mayor a 0")
  price        Float
  /// @zod.positive("La duración del plan debe ser mayor a 0")
  durationDays Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]

  @@map("membership_plans")
}

model ClassSchedule {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  category        ClassCategory
  /// @zod.min(1, "La capacidad máxima debe ser al menos 1")
  maxCapacity     Int
  /// @zod.min(1, "La duración en minutos debe ser al menos 1")
  durationMinutes Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions ClassSession[]

  @@map("class_schedules")
}

model ClassSession {
  id                Int         @id @default(autoincrement())
  classScheduleId   Int
  instructorId      Int?
  /// @zod.custom.use(z.coerce.date())
  date              DateTime
  /// @zod.regex(/^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/, "El formato de hora debe ser HH:mm")
  startTime         String
  remainingCapacity Int
  status            ClassStatus @default(SCHEDULED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  instructor    Instructor?    @relation(fields: [instructorId], references: [id])
  classSchedule ClassSchedule  @relation(fields: [classScheduleId], references: [id])
  bookings      ClassBooking[]

  @@unique([instructorId, date, startTime]) // mismo instructor no puede estar en dos sesiones al mismo tiempo
  @@index([classScheduleId])
  @@map("class_sessions")
}

model ClassBooking {
  id             Int                @id @default(autoincrement())
  /// @zod.min(1, "El ID de socio debe ser un entero positivo")
  memberId       Int
  /// @zod.min(1, "El ID de la sesión de clase debe ser un entero positivo")
  classSessionId Int
  bookingDate    DateTime           @default(now())
  status         ClassBookingStatus @default(CONFIRMED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  member       Member       @relation(fields: [memberId], references: [id])
  classSession ClassSession @relation(fields: [classSessionId], references: [id])

  @@unique([memberId, classSessionId])
  @@index([memberId])
  @@index([classSessionId, status])
  @@map("class_bookings")
}

model Exercise {
  id              Int                     @id @default(autoincrement())
  /// @zod.min(1, "El nombre del ejercicio no puede estar vacío").max(200, "El nombre no puede superar los 200 caracteres")
  name            String
  /// @zod.max(1000, "La descripción del ejercicio no puede superar los 1000 caracteres")
  description     String?
  /// @zod.min(1, "El grupo muscular no puede estar vacío").max(100, "El grupo muscular no puede superar los 100 caracteres")
  muscleGroup     String
  difficultyLevel DifficultyLevelExercise

  routineExercises RoutineExercise[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, muscleGroup])
  @@map("exercises")
}

model Routine {
  id          Int               @id @default(autoincrement())
  /// @zod.min(1, "El nombre de la rutina no puede estar vacío").max(200, "El nombre no puede superar los 200 caracteres")
  name        String
  /// @zod.max(1000, "La descripción de la rutina no puede superar los 1000 caracteres")
  description String?
  difficulty  DifficultyLevelExercise
  instructor  Instructor        @relation(fields: [instructorId], references: [id])
  instructorId Int

  routineExercises RoutineExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("routines")
}

model RoutineExercise {
  id         Int     @id @default(autoincrement())
  routine    Routine @relation(fields: [routineId], references: [id])
  routineId  Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId Int

  /// @zod.min(0, "El orden debe ser 0 o mayor")
  order Int?
  /// @zod.min(0, "Las repeticiones deben ser 0 o mayores")
  reps  Int?
  /// @zod.min(0, "Las series deben ser 0 o mayores")
  sets  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([routineId])
  @@index([exerciseId])
  @@map("routine_exercises")
}

enum ClassBookingStatus {
  CONFIRMED
  CANCELLED
}

enum ClassCategory {
  CARDIO
  CROSSFIT
  DANCE
  FUNCTIONAL
  HIIT
  OTHER
  PILATES
  SPINNING
  STRETCHING
  YOGA
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
}

enum DifficultyLevelExercise {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  CASH
  OTHER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum docType {
  DNI
  PASAPORTE
}
