// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Member {
  id       Int      @id @default(autoincrement())
  name     String
  surname  String
  email    String   @unique
  phone    String?
  joinDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membership Membership?

  @@map("members")
}

model Instructor {
  id       Int      @id @default(autoincrement())
  name     String
  surname  String
  email    String   @unique
  phone    String?
  joinDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instructors")
}

model Membership {
  id                Int              @id @default(autoincrement())
  startDate         DateTime         @default(now())
  endDate           DateTime
  status            MembershipStatus @default(active)
  lastPaymentMethod PaymentMethod
  lastAmountPaid    Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // UN SOCIO TIENE SOLO UNA MEMBRESÍA (1:1)
  member   Member @relation(fields: [memberId], references: [id])
  memberId Int    @unique

  // MUCHAS MEMBRESÍAS COMPARTEN EL MISMO PLAN (1:N)
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])
  membershipPlanId Int

  @@map("memberships")
}

model MembershipPlan {
  id           Int          @id @default(autoincrement())
  name         String
  description  String?
  price        Float
  durationDays Int
  memberships  Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membership_plans")
}

model Exercise {
  id              Int                     @id @default(autoincrement())
  name            String
  description     String?
  muscleGroup     String
  difficultyLevel DifficultyLevelExercise

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exercises")
}

enum MembershipStatus {
  active
  expired
  canceled
}

enum PaymentMethod {
  transfer
  cash
  card
  other
}

enum DifficultyLevelExercise {
  beginner
  intermediate
  advanced
}
