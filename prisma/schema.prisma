// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MembershipStatus {
  ACTIVO
  VENCIDO
  CANCELADO
}

PaymentMethod {
  TRANSFERENCIA
  EFECTIVO
  TARJETA
  OTRO
}

enum DifficultyLevelExercise {
 beginner
 intermediate
 advanced
}

model Exercise {
 id          Int      @id @default(autoincrement())
 name        String
 description String?
 muscleGroup String
 difficultyLevel DifficultyLevelExercise

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model Member {
  id          Int      @id @default(autoincrement())
  name        String
  surname     String
  idNumber    String   @unique
  email       String   @unique
  phone       String?
  joinDate    DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membership  Membership?
}

model Membership {
  id                Int               @id @default(autoincrement())
  startDate         DateTime          @default(now())
  endDate           DateTime
  status            MembershipStatus  @default(ACTIVO)
  lastPaymentMethod PaymentMethod 
  lastAmountPaid    Float
  member            Member            @relation(fields: [memberId], references: [id])
  memberId          Int               @unique // FK 0:1          
}

model Instructor {
  id        Int     @id @default(autoincrement())
  name      String
  surname   String
  email     String   @unique
  phone     String?
  joinDate  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
