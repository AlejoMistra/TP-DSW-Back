@baseUrl = http://localhost:3000/api

### 1. Iniciar sesión como ADMIN (guarda el token)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@gym.com",
  "password": "admin1234"
}

### Extraer token admin
@adminToken = {{loginAdmin.response.body.token}}

### 2. Iniciar sesión como SOCIO (MEMBER)
# @name loginMember
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "juan.perez@example.com",
  "password": "member1234"
}

### Extraer token socio
@memberToken = {{loginMember.response.body.token}}

### 3. Iniciar sesión como INSTRUCTOR
# @name loginInstructor
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gabrielmartinez@gmail.com",
  "password": "instructor1234"
}

### Extraer token instructor
@instructorToken = {{loginInstructor.response.body.token}}


### ========================================================
### CASOS DE PRUEBA: AUTENTICACIÓN (401 UNAUTHORIZED)
### ========================================================

### 3. Petición sin token a endpoint protegido (debe retornar 401 UNAUTHORIZED)
GET {{baseUrl}}/users

### 4. Petición con token malformado/inválido (debe retornar 401 UNAUTHORIZED)
GET {{baseUrl}}/users
Authorization: Bearer token_totalmente_invalido


### ========================================================
### CASOS DE PRUEBA: AUTORIZACIÓN POR ROL (403 FORBIDDEN)
### ========================================================

### 5. Socio intenta acceder a listar usuarios (Solo ADMIN) -> 403 FORBIDDEN
GET {{baseUrl}}/users
Authorization: Bearer {{memberToken}}

### 6. Socio intenta crear un ejercicio (Solo ADMIN o INSTRUCTOR) -> 403 FORBIDDEN
POST {{baseUrl}}/exercises
Content-Type: application/json
Authorization: Bearer {{memberToken}}

{
  "name": "Intento no autorizado",
  "description": "Debe fallar con 403"
}

### 7. Socio intenta crear un plan de membresía (Solo ADMIN) -> 403 FORBIDDEN
POST {{baseUrl}}/membership-plans
Content-Type: application/json
Authorization: Bearer {{memberToken}}

{
  "name": "Plan Hack",
  "description": "Plan no permitido",
  "price": 100,
  "durationMonths": 1
}

### 8. Socio intenta ver a otro socio por ID (Prevención IDOR: Solo ADMIN o INSTRUCTOR) -> 403 FORBIDDEN
GET {{baseUrl}}/members/2
Authorization: Bearer {{memberToken}}

### 9. Socio intenta ver membresía por ID (Prevención IDOR: Solo ADMIN) -> 403 FORBIDDEN
GET {{baseUrl}}/memberships/1
Authorization: Bearer {{memberToken}}

### 10. Socio intenta ver un pago por ID (Prevención IDOR: Solo ADMIN) -> 403 FORBIDDEN
GET {{baseUrl}}/payments/1
Authorization: Bearer {{memberToken}}


### ========================================================
### CASOS DE PRUEBA: ACCESO PERMITIDO (200 / 201 OK)
### ========================================================

### 11. Admin accede a listar usuarios -> 200 OK
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

### 12. Socio accede a ver ejercicios -> 200 OK
GET {{baseUrl}}/exercises
Authorization: Bearer {{memberToken}}

### 13. Socio accede a ver planes de membresía -> 200 OK
GET {{baseUrl}}/membership-plans
Authorization: Bearer {{memberToken}}

### 14. Socio accede a ver horarios de clase -> 200 OK
GET {{baseUrl}}/classSchedules
Authorization: Bearer {{memberToken}}

### 15. Socio consulta su propio perfil (/me) -> 200 OK
GET {{baseUrl}}/members/me
Authorization: Bearer {{memberToken}}

### 16. Socio actualiza su propio perfil (/me) -> 200 OK
PATCH {{baseUrl}}/members/me
Content-Type: application/json
Authorization: Bearer {{memberToken}}

{
  "phone": "3415551234"
}

### 17. Socio consulta su propia membresía (/me) -> 200 OK
GET {{baseUrl}}/memberships/me
Authorization: Bearer {{memberToken}}

### 18. Socio consulta sus propios pagos (/me) -> 200 OK
GET {{baseUrl}}/payments/me
Authorization: Bearer {{memberToken}}

