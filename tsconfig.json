{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts"
  ]
}