# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Opción 1: Connection URL - TiDB Cloud / Producción)
# En TiDB Cloud (Serverless), se obtiene una URL segura con TLS/SSL (puerto 4000):
DATABASE_URL="mysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<dbname>?sslaccept=strict"

# Database Configuration (Opción 2: Variables individuales - Desarrollo local)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=change_me
DATABASE_NAME=tp_dsw

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# CORS Frontend URLs (requerido en producción: lista separada por comas de dominios permitidos)
# En desarrollo se permite cualquier origen (*) sin necesidad de configurarlo.
# FRONTEND_URL=https://mi-frontend.vercel.app,https://admin.mi-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
